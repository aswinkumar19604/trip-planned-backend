# Flask Environment Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=super-secret-trip-planning-key-change-in-prod
JWT_SECRET_KEY=jwt-secret-key-change-in-prod-xyz123

# MongoDB Connection
# For local development:
MONGO_URI=mongodb://127.0.0.1:27017/trip_planner_db
# For production (MongoDB Atlas M0 Free):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trip_planner_db?retryWrites=true&w=majority

# Welcome Email SMTP Configuration (Gmail, SendGrid, Mailgun, etc.)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@tripplanner.com

